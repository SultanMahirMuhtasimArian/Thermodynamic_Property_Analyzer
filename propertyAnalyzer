function formatVal(v, decimals) {
  if (v === null || v === undefined) return '—';
  if (typeof v !== 'number') return String(v);
  if (Math.abs(v) >= 10000 || (Math.abs(v) < 0.001 && v !== 0)) {
    return v.toExponential(5);
  }
  return v.toFixed(decimals !== undefined ? decimals : 6);
}

function getPhaseClass(phase) {
  if (!phase) return '';
  const p = phase.toLowerCase();
  if (p.includes('mixture')) return 'phase-sat-mix';
  if (p.includes('superheated')) return 'phase-sup-vap';
  if (p.includes('compressed')) return 'phase-comp-liq';
  if (p.includes('liquid')) return 'phase-sat-liq';
  if (p.includes('vapor')) return 'phase-sat-vap';
  return '';
}

