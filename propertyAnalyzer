      </div>
      <div class="result-value">${formatVal(c.val, c.decimals)}</div>
      <div class="result-unit">${c.unit}</div>
    </div>
    `).join('')}
  </div>

  <div class="section-heading">State Summary</div>
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:16px;max-width:640px">
    <div class="info-row">
      <span class="info-key">Substance</span>
      <span class="info-val">${SUBSTANCES[state.substance]?.label}</span>
    </div>
    <div class="info-row">
      <span class="info-key">Phase</span>
      <span class="info-val">${r.phase || '—'}</span>
    </div>
    <div class="info-row">
      <span class="info-key">Inputs Used</span>
      <span class="info-val">${state.prop1} = ${state.val1} ${PROPS[state.prop1].unit}, ${state.prop2} = ${state.val2} ${PROPS[state.prop2].unit}</span>
    </div>
    <div class="info-row">
      <span class="info-key">Source Table(s)</span>
      <span class="info-val">${r.source || '—'}</span>
    </div>
    <div class="info-row">
      <span class="info-key">Method</span>
      <span class="info-val">${r.interpMethod || '—'}</span>
    </div>
    ${r.x !== null && r.x !== undefined ? `
    <div class="info-row">
      <span class="info-key">Quality x</span>
      <span class="info-val">${(r.x*100).toFixed(2)}% (${r.x.toFixed(6)})</span>
    </div>
    ` : ''}
  </div>
  `;
}

function render() {
  document.getElementById('sidebar').innerHTML = renderSidebar();
  document.getElementById('main').innerHTML = renderMain();
}

function onSubstanceChange(val) {
  state.substance = val;
  state.prop1 = 'T';
  state.prop2 = state.substance === 'r134a' ? 'P' : 'P';
  state.val1 = '';
  state.val2 = '';
  state.result = null;
  render();
}

function onProp1Change(val) {
  state.prop1 = val;
  if (state.prop2 === val) {
    const others = Object.keys(PROPS).filter(p=>p!==val);
    state.prop2 = others[0];
  }
  state.result = null;
  render();
}

function onProp2Change(val) {
  state.prop2 = val;
  if (state.prop1 === val) {
    const others = Object.keys(PROPS).filter(p=>p!==val);
    state.prop1 = others[0];
  }
  state.result = null;
  render();
}

function onCalculate() {
  const v1 = parseFloat(document.getElementById('inp-val1').value);
  const v2 = parseFloat(document.getElementById('inp-val2').value);
  state.val1 = document.getElementById('inp-val1').value;
  state.val2 = document.getElementById('inp-val2').value;
  
  if (isNaN(v1) || isNaN(v2)) {
    state.result = {error:'Please enter valid numeric values for both properties.'};
    render();
    return;
  }
  
  state.result = solve(state.substance, state.prop1, v1, state.prop2, v2);
  render();
}

function onReset() {
  state.val1 = '';
  state.val2 = '';
  state.result = null;
  render();
}

function loadExample(vals) {
  state.prop1 = vals.prop1;
  state.prop2 = vals.prop2;
  state.val1 = vals.val1;
  state.val2 = vals.val2;
  state.result = null;
  render();
  // Trigger calculation
  const v1 = parseFloat(vals.val1);
  const v2 = parseFloat(vals.val2);
  state.result = solve(state.substance, state.prop1, v1, state.prop2, v2);
  render();
}

// Keyboard shortcut
document.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) {
    const activeEl = document.activeElement;
    if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'SELECT')) {
      onCalculate();
    }
  }
});

// Initial render
render();
</script>
</body>
</html>
