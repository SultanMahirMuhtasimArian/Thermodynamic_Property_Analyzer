// ============================================================
// INTERPOLATION ENGINE
// ============================================================

function lerp(x0, x1, y0, y1, x) {
  if (Math.abs(x1 - x0) < Number.EPSILON * 1e10) return y0;
  const t = (x - x0) / (x1 - x0);
  return y0 + t * (y1 - y0);
}

function interpolate1D(table, keyIdx, valIdx, keyVal) {
  const sorted = [...table].sort((a, b) => a[keyIdx] - b[keyIdx]);
  if (keyVal <= sorted[0][keyIdx]) return sorted[0][valIdx];
  if (keyVal >= sorted[sorted.length-1][keyIdx]) return sorted[sorted.length-1][valIdx];
  for (let i = 0; i < sorted.length - 1; i++) {
    if (keyVal >= sorted[i][keyIdx] && keyVal <= sorted[i+1][keyIdx]) {
      return lerp(sorted[i][keyIdx], sorted[i+1][keyIdx], sorted[i][valIdx], sorted[i+1][valIdx], keyVal);
    }
  }
  return null;
}

function interpolate1DAll(table, keyIdx, keyVal) {
  const sorted = [...table].sort((a, b) => a[keyIdx] - b[keyIdx]);
  const n = sorted.length;
  if (keyVal <= sorted[0][keyIdx]) return [...sorted[0]];
  if (keyVal >= sorted[n-1][keyIdx]) return [...sorted[n-1]];
  for (let i = 0; i < n - 1; i++) {
    if (keyVal >= sorted[i][keyIdx] && keyVal <= sorted[i+1][keyIdx]) {
      const t = (keyVal - sorted[i][keyIdx]) / (sorted[i+1][keyIdx] - sorted[i][keyIdx]);
      return sorted[i].map((v, idx) => v + t * (sorted[i+1][idx] - v));
    }
  }
  return null;
}

// Bilinear interpolation for superheated tables
function interpolateSuperheated(supTable, P_MPa, T_C) {
  const pressures = Object.keys(supTable).map(Number).sort((a,b) => a-b);
  
  let pLow, pHigh;
  if (P_MPa <= pressures[0]) { pLow = pressures[0]; pHigh = pressures[0]; }
  else if (P_MPa >= pressures[pressures.length-1]) { pLow = pressures[pressures.length-1]; pHigh = pressures[pressures.length-1]; }
  else {
    for (let i = 0; i < pressures.length-1; i++) {
      if (P_MPa >= pressures[i] && P_MPa <= pressures[i+1]) {
        pLow = pressures[i]; pHigh = pressures[i+1]; break;
      }
    }
  }

  function interpAtP(pKey) {
    const temps = Object.keys(supTable[pKey]).map(Number).sort((a,b)=>a-b);
    if (T_C <= temps[0]) return supTable[pKey][temps[0]];
    if (T_C >= temps[temps.length-1]) return supTable[pKey][temps[temps.length-1]];
    for (let i = 0; i < temps.length-1; i++) {
      if (T_C >= temps[i] && T_C <= temps[i+1]) {
        const t = (T_C - temps[i]) / (temps[i+1] - temps[i]);
        return supTable[pKey][temps[i]].map((v, idx) => v + t * (supTable[pKey][temps[i+1]][idx] - v));
      }
    }
    return null;
  }

  if (pLow === pHigh) return interpAtP(pLow);
  
  const low = interpAtP(pLow);
  const high = interpAtP(pHigh);
  if (!low || !high) return null;
  const tp = (P_MPa - pLow) / (pHigh - pLow);
  return low.map((v, idx) => v + tp * (high[idx] - v));
}

// Get saturation properties at T (from WATER_SAT_T)
// Returns {vf,vg,uf,ufg,ug,hf,hfg,hg,sf,sfg,sg,P} or null
function waterSatAtT(T_C) {
  const row = interpolate1DAll(WATER_SAT_T, 0, T_C);
  if (!row) return null;
  return { T: row[0], P: row[1], vf: row[2], vg: row[3], uf: row[4], ufg: row[5], ug: row[6], hf: row[7], hfg: row[8], hg: row[9], sf: row[10], sfg: row[11], sg: row[12] };
}

// Get saturation properties at P (from WATER_SAT_P)
function waterSatAtP(P_kPa) {
  const row = interpolate1DAll(WATER_SAT_P, 0, P_kPa);
  if (!row) return null;
  return { P: row[0], T: row[1], vf: row[2], vg: row[3], uf: row[4], ufg: row[5], ug: row[6], hf: row[7], hfg: row[8], hg: row[9], sf: row[10], sfg: row[11], sg: row[12] };
}

function r134aSatAtT(T_C) {
  const row = interpolate1DAll(R134A_SAT_T, 0, T_C);
  if (!row) return null;
  return { T: row[0], P: row[1], vf: row[2], vg: row[3], uf: row[4], ufg: row[5], ug: row[6], hf: row[7], hfg: row[8], hg: row[9], sf: row[10], sfg: row[11], sg: row[12] };
}

// R-134a Saturated Pressure interpolation (derived from temp table)
function r134aSatAtP(P_kPa) {
  const sorted = [...R134A_SAT_T].sort((a,b) => a[1]-b[1]);
  const row = interpolate1DAll(sorted, 1, P_kPa);
  if (!row) return null;
  return { T: row[0], P: row[1], vf: row[2], vg: row[3], uf: row[4], ufg: row[5], ug: row[6], hf: row[7], hfg: row[8], hg: row[9], sf: row[10], sfg: row[11], sg: row[12] };
}

// ============================================================
// STATE SOLVER ENGINE
// ============================================================

function round(v, decimals=6) {
  if (v === null || v === undefined || isNaN(v)) return null;
  return parseFloat(v.toFixed(decimals));
}

function calcQuality(val, fVal, fgVal) {
  if (Math.abs(fgVal) < Number.EPSILON) return null;
  return (val - fVal) / fgVal;
}

function solveWater(prop1, val1, prop2, val2) {
  // Determine state from two properties
  // Returns {T,P,v,u,h,s,x,phase,source,interpMethod} or {error}
  
  const pNames = [prop1, prop2].sort().join('-');
  
  // Helper: build state from saturation + quality
  function fromSatAndQuality(sat, x) {
    if (x < -1e-6 || x > 1+1e-6) return {error:`Quality x=${x.toFixed(4)} is outside [0,1]. State is not a saturated mixture.`};
    const xc = Math.max(0, Math.min(1, x));
    return {
      T: round(sat.T), P: round(sat.P),
      v: round(sat.vf + xc * (sat.vg - sat.vf)),
      u: round(sat.uf + xc * sat.ufg),
      h: round(sat.hf + xc * sat.hfg),
      s: round(sat.sf + xc * sat.sfg),
      x: round(xc, 6), phase: xc <= 1e-6 ? 'Saturated Liquid' : xc >= 1-1e-6 ? 'Saturated Vapor' : 'Saturated Mixture',
      source: 'Çengel Table A-4/A-5 (Saturated Water)', interpMethod: 'Linear interpolation + quality calculation'
    };
  }

  // T and x
  if ((prop1==='T'&&prop2==='x')||(prop1==='x'&&prop2==='T')) {
    const T = prop1==='T' ? val1 : val2;
    const x = prop1==='x' ? val1 : val2;
    if (T < 0.01 || T > 373.95) return {error:`Temperature ${T}°C is outside saturation range [0.01, 373.95]°C`};
    const sat = waterSatAtT(T);
    if (!sat) return {error:'Could not interpolate saturation properties at given T'};
    return fromSatAndQuality(sat, x);
  }

  // P and x
  if ((prop1==='P'&&prop2==='x')||(prop1==='x'&&prop2==='P')) {
    const P = prop1==='P' ? val1 : val2;
    const x = prop1==='x' ? val1 : val2;
    if (P < 0.6117 || P > 22064) return {error:`Pressure ${P} kPa is outside saturation range [0.6117, 22064] kPa`};
    const sat = waterSatAtP(P);
    if (!sat) return {error:'Could not interpolate saturation properties at given P'};
    return fromSatAndQuality(sat, x);
  }

  // T and P
  if ((prop1==='T'&&prop2==='P')||(prop1==='P'&&prop2==='T')) {
    const T = prop1==='T' ? val1 : val2;
    const P_kPa = prop1==='P' ? val1 : val2;
    const P_MPa = P_kPa / 1000;
    
    if (T < 0.01) return {error:'Temperature below minimum (0.01°C)'};
    if (P_kPa < 0.001) return {error:'Pressure below minimum'};

    // Get saturation pressure at T
    if (T <= 373.95) {
      const sat = waterSatAtT(T);
      if (sat) {
        const P_sat = sat.P;
        if (Math.abs(P_kPa - P_sat) / P_sat < 0.001) {
          // On saturation curve — ambiguous, assume sat liquid
          return {T:round(T),P:round(P_kPa),v:round(sat.vf),u:round(sat.uf),h:round(sat.hf),s:round(sat.sf),x:0,
            phase:'Saturated Liquid (on sat. curve)',source:'Çengel Table A-4 (Saturated Water — Temperature)',interpMethod:'Linear interpolation'};
        }
        if (P_kPa > P_sat) {
          // Compressed liquid — use compressed liquid approximation
          // h ≈ hf + vf*(P-Psat) (in kJ/kg, P in kPa)
          const h_approx = sat.hf + sat.vf * (P_kPa - P_sat);
          const u_approx = sat.uf; // approximately same as uf
          const v_approx = sat.vf; // approximately same as vf
          const s_approx = sat.sf; // approximately same as sf
          return {T:round(T),P:round(P_kPa),v:round(v_approx,7),u:round(u_approx),h:round(h_approx),s:round(s_approx),x:null,
            phase:'Compressed Liquid',source:'Çengel Table A-4 (Sat.) + compressed liquid approximation (h≈hf@T + vf·ΔP)',interpMethod:'Compressed liquid approximation'};
        }
        // P < P_sat → Superheated
      }
    }
    
    // Superheated lookup
    if (P_MPa < 0.01 || P_MPa > 50) return {error:`Pressure ${P_kPa} kPa (${P_MPa} MPa) outside superheated table range [10, 50000] kPa`};
    const supProps = interpolateSuperheated(WATER_SUP, P_MPa, T);
    if (!supProps) return {error:'Could not interpolate superheated properties at given T,P'};
    return {T:round(T),P:round(P_kPa),v:round(supProps[0],7),u:round(supProps[1]),h:round(supProps[2]),s:round(supProps[3]),x:null,
      phase:'Superheated Vapor',source:'Çengel Table A-6 (Superheated Water)',interpMethod:'Bilinear interpolation (T,P)'};
  }

  // P and h
  if ((prop1==='P'&&prop2==='h')||(prop1==='h'&&prop2==='P')) {
    const P_kPa = prop1==='P' ? val1 : val2;
    const h = prop1==='h' ? val1 : val2;
    const P_MPa = P_kPa / 1000;
    
    if (P_kPa >= 0.6117 && P_kPa <= 22064) {
      const sat = waterSatAtP(P_kPa);
      if (sat) {
        if (h < sat.hf) {
          // Compressed — approximate T from hf
          const T_approx = interpolate1D(WATER_SAT_P, 7, 1, h);
          if (T_approx) {
            const satT = waterSatAtT(T_approx);
            if (satT) {
              const h_approx = satT.hf + satT.vf * (P_kPa - satT.P);
              return {T:round(T_approx),P:round(P_kPa),v:round(satT.vf,7),u:round(satT.uf),h:round(h),s:round(satT.sf),x:null,
                phase:'Compressed Liquid',source:'Çengel Table A-4/A-5 (approx.)',interpMethod:'Inverse interpolation on hf'};
            }
          }
        }
        if (h <= sat.hg) {
          const x = calcQuality(h, sat.hf, sat.hfg);
          return fromSatAndQuality(sat, x);
        }
        // h > hg → Superheated — need T
        // find T from superheated table at given P
        const T_est = findTfromHatP_water(P_MPa, h);
        if (T_est !== null) {
          const supProps = interpolateSuperheated(WATER_SUP, P_MPa, T_est);
          if (supProps) return {T:round(T_est),P:round(P_kPa),v:round(supProps[0],7),u:round(supProps[1]),h:round(h),s:round(supProps[3]),x:null,
            phase:'Superheated Vapor',source:'Çengel Table A-6 (Superheated Water)',interpMethod:'Inverse interpolation on h at P'};
        }
      }
    }
    return {error:'Could not determine state from P and h. Check input values.'};
  }

  // P and s
  if ((prop1==='P'&&prop2==='s')||(prop1==='s'&&prop2==='P')) {
    const P_kPa = prop1==='P' ? val1 : val2;
    const s = prop1==='s' ? val1 : val2;
    const P_MPa = P_kPa / 1000;
    
    if (P_kPa >= 0.6117 && P_kPa <= 22064) {
      const sat = waterSatAtP(P_kPa);
      if (sat) {
        if (s <= sat.sg && s >= sat.sf) {
          const x = calcQuality(s, sat.sf, sat.sfg);
          return fromSatAndQuality(sat, x);
        }
        if (s < sat.sf) {
