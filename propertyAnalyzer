        if (T_est !== null) {
          const supProps = interpolateSuperheated(WATER_SUP, P_MPa, T_est);
          if (supProps) return {T:round(T_est),P:round(P_kPa),v:round(supProps[0],7),u:round(supProps[1]),h:round(supProps[2]),s:round(s),x:null,
