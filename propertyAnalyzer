      const x = calcQuality(u, sat.uf, sat.ufg);
      return fromSatAndQuality(sat, x);
    }
    return {error:`u=${u} kJ/kg > ug=${sat.ug.toFixed(2)} kJ/kg at T=${T}°C. For superheated, use T and P.`};
  }

  // T and h
  if ((prop1==='T'&&prop2==='h')||(prop1==='h'&&prop2==='T')) {
    const T = prop1==='T' ? val1 : val2;
    const h = prop1==='h' ? val1 : val2;
    if (T > 373.95 || T < 0.01) return {error:`T must be in [0.01, 373.95]°C for T-h inputs`};
    const sat = waterSatAtT(T);
    if (!sat) return {error:'Saturation lookup failed'};
    if (h < sat.hf) return {error:`h=${h} kJ/kg < hf=${sat.hf.toFixed(2)} kJ/kg at T=${T}°C`};
    if (h <= sat.hg) {
      const x = calcQuality(h, sat.hf, sat.hfg);
      return fromSatAndQuality(sat, x);
    }
    return {error:`h > hg at T=${T}°C — superheated state. Use T and P instead.`};
  }

  // T and s
  if ((prop1==='T'&&prop2==='s')||(prop1==='s'&&prop2==='T')) {
    const T = prop1==='T' ? val1 : val2;
    const s = prop1==='s' ? val1 : val2;
    if (T > 373.95 || T < 0.01) return {error:`T must be in [0.01, 373.95]°C for T-s inputs`};
    const sat = waterSatAtT(T);
    if (!sat) return {error:'Saturation lookup failed'};
    if (s < sat.sf) return {error:`s=${s} kJ/kg·K < sf=${sat.sf.toFixed(5)}: compressed liquid state`};
    if (s <= sat.sg) {
      const x = calcQuality(s, sat.sf, sat.sfg);
      return fromSatAndQuality(sat, x);
    }
    return {error:`s > sg at T=${T}°C — superheated. Use T and P.`};
  }

  return {error:`Property combination [${prop1}, ${prop2}] not yet supported for Water. Try T+P, T+x, P+x, P+h, P+s, T+v, T+u, T+h, or T+s.`};
}

function findTfromHatP_water(P_MPa, h_target) {
  const tKey = Object.keys(WATER_SUP[Object.keys(WATER_SUP).map(Number).sort((a,b)=>a-b).find(p=>p>=P_MPa)||Object.keys(WATER_SUP).map(Number).sort((a,b)=>a-b).slice(-1)[0]]);
  const pressures = Object.keys(WATER_SUP).map(Number).sort((a,b)=>a-b);
  let p1 = pressures.find(p=>p>=P_MPa) || pressures[pressures.length-1];
  let p0 = pressures.reverse().find(p=>p<=P_MPa) || pressures[0];
  pressures.sort((a,b)=>a-b);
  
  const tableAtP = (pkey) => {
    const temps = Object.keys(WATER_SUP[pkey]).map(Number).sort((a,b)=>a-b);
    return temps.map(t=>({T:t, h:WATER_SUP[pkey][t][2]}));
  };
  
  let best = null, minDiff = Infinity;
  for (const pKey of [p0, p1]) {
    const entries = tableAtP(pKey);
    for (let i=0; i<entries.length-1; i++) {
      if ((h_target >= entries[i].h && h_target <= entries[i+1].h) ||
          (h_target <= entries[i].h && h_target >= entries[i+1].h)) {
        const T = lerp(entries[i].h, entries[i+1].h, entries[i].T, entries[i+1].T, h_target);
        return T;
      }
    }
  }
  return null;
}

function findTfromSatP_water(P_MPa, s_target) {
  const pressures = Object.keys(WATER_SUP).map(Number).sort((a,b)=>a-b);
  const p1 = pressures.find(p=>p>=P_MPa) || pressures[pressures.length-1];
  const p0 = [...pressures].reverse().find(p=>p<=P_MPa) || pressures[0];
  
  for (const pKey of [p0, p1]) {
    const temps = Object.keys(WATER_SUP[pKey]).map(Number).sort((a,b)=>a-b);
    const entries = temps.map(t=>({T:t, s:WATER_SUP[pKey][t][3]}));
    for (let i=0; i<entries.length-1; i++) {
      if (s_target >= entries[i].s && s_target <= entries[i+1].s) {
        return lerp(entries[i].s, entries[i+1].s, entries[i].T, entries[i+1].T, s_target);
      }
    }
  }
  return null;
}

function findPfromVatT_water(T, v_target) {
  const pressures = Object.keys(WATER_SUP).map(Number).sort((a,b)=>a-b);
  const vAtP = (pKey) => {
    const temps = Object.keys(WATER_SUP[pKey]).map(Number).sort((a,b)=>a-b);
    if (T < temps[0] || T > temps[temps.length-1]) return null;
    for (let i=0; i<temps.length-1; i++) {
      if (T >= temps[i] && T <= temps[i+1]) {
        return lerp(temps[i], temps[i+1], WATER_SUP[pKey][temps[i]][0], WATER_SUP[pKey][temps[i+1]][0], T);
      }
    }
    return null;
  };
  
  const pvPairs = pressures.map(p=>({P:p, v:vAtP(p)})).filter(x=>x.v!==null);
  pvPairs.sort((a,b)=>b.v-a.v); // higher v = lower P
  
  for (let i=0; i<pvPairs.length-1; i++) {
    if (v_target >= pvPairs[i+1].v && v_target <= pvPairs[i].v) {
      return lerp(pvPairs[i].v, pvPairs[i+1].v, pvPairs[i].P, pvPairs[i+1].P, v_target);
    }
  }
  return null;
}

// R-134a solver
function solveR134a(prop1, val1, prop2, val2) {
  function fromSatAndQuality134a(sat, x) {
    if (x < -1e-6 || x > 1+1e-6) return {error:`Quality x=${x.toFixed(4)} outside [0,1]`};
    const xc = Math.max(0, Math.min(1, x));
    return {
      T: round(sat.T), P: round(sat.P),
      v: round(sat.vf + xc * (sat.vg - sat.vf), 7),
      u: round(sat.uf + xc * sat.ufg),
      h: round(sat.hf + xc * sat.hfg),
      s: round(sat.sf + xc * sat.sfg),
      x: round(xc), phase: xc<=1e-6?'Saturated Liquid':xc>=1-1e-6?'Saturated Vapor':'Saturated Mixture',
      source:'Çengel Table A-11 (Saturated R-134a — Temperature)', interpMethod:'Linear interpolation + quality'
    };
  }

  if ((prop1==='T'&&prop2==='x')||(prop1==='x'&&prop2==='T')) {
    const T = prop1==='T'?val1:val2, x = prop1==='x'?val1:val2;
    if (T<-40||T>100) return {error:`T=${T}°C outside R-134a sat range [-40, 100]°C`};
    const sat = r134aSatAtT(T); if (!sat) return {error:'Saturation lookup failed'};
    return fromSatAndQuality134a(sat, x);
  }

  if ((prop1==='P'&&prop2==='x')||(prop1==='x'&&prop2==='P')) {
    const P = prop1==='P'?val1:val2, x = prop1==='x'?val1:val2;
    if (P<51.25||P>3975.1) return {error:`P=${P} kPa outside R-134a sat range [51.25, 3975.1] kPa`};
    const sat = r134aSatAtP(P); if (!sat) return {error:'Saturation lookup failed at given P'};
    return fromSatAndQuality134a(sat, x);
  }

  if ((prop1==='T'&&prop2==='P')||(prop1==='P'&&prop2==='T')) {
    const T = prop1==='T'?val1:val2, P_kPa = prop1==='P'?val1:val2;
    const P_MPa = P_kPa/1000;
    const sat = r134aSatAtT(T);
    if (sat) {
      const Psat = sat.P;
      if (Math.abs(P_kPa-Psat)/Psat < 0.001) return fromSatAndQuality134a(sat, 0);
      if (P_kPa > Psat) {
        return {T:round(T),P:round(P_kPa),v:round(sat.vf,7),u:round(sat.uf),h:round(sat.hf+sat.vf*(P_kPa-Psat)),s:round(sat.sf),x:null,
          phase:'Compressed Liquid',source:'Çengel Table A-11 + compressed approx.',interpMethod:'Compressed liquid approximation'};
      }
    }
    const supProps = interpolateSuperheated(R134A_SUP, P_MPa, T);
    if (!supProps) return {error:'Superheated lookup failed for R-134a at given T,P'};
    return {T:round(T),P:round(P_kPa),v:round(supProps[0],7),u:round(supProps[1]),h:round(supProps[2]),s:round(supProps[3]),x:null,
      phase:'Superheated Vapor',source:'Çengel Table A-13 (Superheated R-134a)',interpMethod:'Bilinear interpolation (T,P)'};
  }

  if ((prop1==='P'&&prop2==='h')||(prop1==='h'&&prop2==='P')) {
    const P_kPa = prop1==='P'?val1:val2, h = prop1==='h'?val1:val2;
    const P_MPa = P_kPa/1000;
    const sat = r134aSatAtP(P_kPa);
    if (sat) {
      if (h <= sat.hg && h >= sat.hf) {
        const x = calcQuality(h, sat.hf, sat.hfg);
        return fromSatAndQuality134a(sat, x);
      }
      if (h > sat.hg) {
        const T_est = findTfromHatP_R134a(P_MPa, h);
        if (T_est!==null) {
          const sp = interpolateSuperheated(R134A_SUP, P_MPa, T_est);
          if (sp) return {T:round(T_est),P:round(P_kPa),v:round(sp[0],7),u:round(sp[1]),h:round(h),s:round(sp[3]),x:null,
            phase:'Superheated Vapor',source:'Çengel Table A-13 (Superheated R-134a)',interpMethod:'Inverse h interpolation'};
        }
      }
    }
    return {error:'Could not determine R-134a state from P and h.'};
  }

  if ((prop1==='P'&&prop2==='s')||(prop1==='s'&&prop2==='P')) {
    const P_kPa = prop1==='P'?val1:val2, s = prop1==='s'?val1:val2;
    const P_MPa = P_kPa/1000;
    const sat = r134aSatAtP(P_kPa);
    if (sat) {
      if (s <= sat.sg && s >= sat.sf) {
        const x = calcQuality(s, sat.sf, sat.sfg);
        return fromSatAndQuality134a(sat, x);
      }
      if (s > sat.sg) {
        const T_est = findTfromSatP_R134a(P_MPa, s);
        if (T_est!==null) {
          const sp = interpolateSuperheated(R134A_SUP, P_MPa, T_est);
          if (sp) return {T:round(T_est),P:round(P_kPa),v:round(sp[0],7),u:round(sp[1]),h:round(sp[2]),s:round(s),x:null,
            phase:'Superheated Vapor',source:'Çengel Table A-13 (Superheated R-134a)',interpMethod:'Inverse s interpolation'};
        }
      }
    }
    return {error:'Could not determine R-134a state from P and s.'};
  }

  if ((prop1==='T'&&prop2==='v')||(prop1==='v'&&prop2==='T')) {
    const T = prop1==='T'?val1:val2, v = prop1==='v'?val1:val2;
    if (T>=-40&&T<=100) {
      const sat = r134aSatAtT(T);
      if (sat && v>=sat.vf && v<=sat.vg) {
        const x = calcQuality(v, sat.vf, sat.vg-sat.vf);
        return fromSatAndQuality134a(sat, x);
      }
    }
    return {error:'T-v state outside saturation dome for R-134a; use T+P for superheated.'};
  }

  return {error:`Property combination [${prop1}, ${prop2}] not supported for R-134a. Try T+x, P+x, T+P, P+h, P+s, T+v.`};
}

function findTfromHatP_R134a(P_MPa, h_target) {
  const pressures = Object.keys(R134A_SUP).map(Number).sort((a,b)=>a-b);
  const p1 = pressures.find(p=>p>=P_MPa)||pressures[pressures.length-1];
  const p0 = [...pressures].reverse().find(p=>p<=P_MPa)||pressures[0];
  for (const pKey of [p0,p1]) {
    const temps = Object.keys(R134A_SUP[pKey]).map(Number).sort((a,b)=>a-b);
    const entries = temps.map(t=>({T:t,h:R134A_SUP[pKey][t][2]}));
    for (let i=0;i<entries.length-1;i++) {
      if (h_target>=entries[i].h&&h_target<=entries[i+1].h) {
        return lerp(entries[i].h,entries[i+1].h,entries[i].T,entries[i+1].T,h_target);
      }
    }
  }
  return null;
}

function findTfromSatP_R134a(P_MPa, s_target) {
  const pressures = Object.keys(R134A_SUP).map(Number).sort((a,b)=>a-b);
  const p1 = pressures.find(p=>p>=P_MPa)||pressures[pressures.length-1];
  const p0 = [...pressures].reverse().find(p=>p<=P_MPa)||pressures[0];
  for (const pKey of [p0,p1]) {
    const temps = Object.keys(R134A_SUP[pKey]).map(Number).sort((a,b)=>a-b);
    const entries = temps.map(t=>({T:t,s:R134A_SUP[pKey][t][3]}));
    for (let i=0;i<entries.length-1;i++) {
      if (s_target>=entries[i].s&&s_target<=entries[i+1].s) {
        return lerp(entries[i].s,entries[i+1].s,entries[i].T,entries[i+1].T,s_target);
      }
    }
  }
  return null;
}

// ============================================================
// MAIN SOLVE DISPATCH
// ============================================================
function solve(substance, prop1, val1, prop2, val2) {
  if (isNaN(val1)||isNaN(val2)) return {error:'Both input values must be valid numbers.'};
  if (prop1===prop2) return {error:'Both input properties must be different (independent properties).'};
  
  if (substance==='water') return solveWater(prop1,val1,prop2,val2);
  if (substance==='r134a') return solveR134a(prop1,val1,prop2,val2);
  return {error:`Unknown substance: ${substance}`};
}

