        }
      }
    }
    return {error:'Could not determine state from P and s.'};
  }

  // T and v
  if ((prop1==='T'&&prop2==='v')||(prop1==='v'&&prop2==='T')) {
    const T = prop1==='T' ? val1 : val2;
    const v = prop1==='v' ? val1 : val2;
    if (T < 0.01 || T > 373.95) return {error:`T=${T}°C outside saturation range for T-v state determination`};
    const sat = waterSatAtT(T);
    if (!sat) return {error:'Saturation interpolation failed'};
    if (v < sat.vf) return {error:`v=${v} m³/kg < vf=${sat.vf.toFixed(7)} m³/kg at T=${T}°C. This is a compressed liquid — provide P as second input.`};
    if (v <= sat.vg) {
      const x = calcQuality(v, sat.vf, sat.vg - sat.vf);
      return fromSatAndQuality(sat, x);
    }
    // Superheated — find P
    const P_MPa = findPfromVatT_water(T, v);
    if (P_MPa !== null) {
      const supProps = interpolateSuperheated(WATER_SUP, P_MPa, T);
      if (supProps) return {T:round(T),P:round(P_MPa*1000),v:round(v,7),u:round(supProps[1]),h:round(supProps[2]),s:round(supProps[3]),x:null,
        phase:'Superheated Vapor',source:'Çengel Table A-6 (Superheated Water)',interpMethod:'Inverse interpolation on v at T'};
    }
    return {error:'Could not resolve superheated state from T and v.'};
  }

  // T and u
  if ((prop1==='T'&&prop2==='u')||(prop1==='u'&&prop2==='T')) {
    const T = prop1==='T' ? val1 : val2;
    const u = prop1==='u' ? val1 : val2;
    if (T > 373.95 || T < 0.01) return {error:`T=${T}°C must be in [0.01, 373.95]°C for T-u inputs`};
