<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ThermoState — Advanced Property Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0c0f;
  --bg2: #111318;
  --bg3: #181c23;
  --bg4: #1e2330;
  --border: #252c3a;
  --border2: #2e3748;
  --text: #e8edf5;
  --text2: #8a95a8;
  --text3: #5a6478;
  --accent: #3b82f6;
  --accent2: #1d4ed8;
  --teal: #14b8a6;
  --amber: #f59e0b;
  --red: #ef4444;
  --green: #22c55e;
  --purple: #a78bfa;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:'IBM Plex Sans',sans-serif;font-size:14px;overflow-x:hidden}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:var(--bg2)}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

/* Layout */
.app{display:grid;grid-template-columns:340px 1fr;grid-template-rows:auto 1fr;min-height:100vh}
.topbar{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;padding:12px 24px;border-bottom:1px solid var(--border);background:var(--bg2)}
.topbar-logo{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;letter-spacing:-0.3px;color:var(--text)}
.topbar-logo .dot{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.topbar-sub{font-size:11px;color:var(--text3);font-family:'IBM Plex Mono',monospace;letter-spacing:0.5px}

/* Sidebar */
.sidebar{background:var(--bg2);border-right:1px solid var(--border);padding:0;overflow-y:auto}
.sidebar-section{padding:16px 20px;border-bottom:1px solid var(--border)}
.sidebar-label{font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--text3);margin-bottom:10px}

select,input[type=number]{width:100%;background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:8px 12px;border-radius:6px;font-family:'IBM Plex Sans',sans-serif;font-size:13px;outline:none;transition:border-color 0.15s}
select:focus,input[type=number]:focus{border-color:var(--accent)}
select option{background:var(--bg3)}

.input-group{margin-bottom:12px}
.input-label{font-size:11px;color:var(--text2);margin-bottom:5px;display:flex;justify-content:space-between;align-items:center}
.unit-badge{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--text3);background:var(--bg4);padding:2px 6px;border-radius:3px}

.btn-calc{width:100%;padding:11px;background:var(--accent);color:#fff;border:none;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;letter-spacing:0.3px;transition:background 0.15s}
.btn-calc:hover{background:var(--accent2)}
.btn-calc:disabled{background:var(--bg4);color:var(--text3);cursor:not-allowed}
.btn-reset{width:100%;padding:9px;background:transparent;color:var(--text2);border:1px solid var(--border);border-radius:6px;font-size:12px;cursor:pointer;margin-top:8px;transition:all 0.15s}
.btn-reset:hover{border-color:var(--border2);color:var(--text)}

/* Phase indicator */
.phase-badge{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:20px;font-size:11px;font-weight:600;letter-spacing:0.5px;margin-top:4px}
.phase-sat-mix{background:rgba(245,158,11,0.15);color:var(--amber);border:1px solid rgba(245,158,11,0.3)}
.phase-sup-vap{background:rgba(59,130,246,0.15);color:var(--accent);border:1px solid rgba(59,130,246,0.3)}
.phase-comp-liq{background:rgba(20,184,166,0.15);color:var(--teal);border:1px solid rgba(20,184,166,0.3)}
.phase-sat-liq{background:rgba(34,197,94,0.15);color:var(--green);border:1px solid rgba(34,197,94,0.3)}
.phase-sat-vap{background:rgba(167,139,250,0.15);color:var(--purple);border:1px solid rgba(167,139,250,0.3)}

/* Main panel */
.main{padding:24px;overflow-y:auto}
.provenance-bar{background:linear-gradient(135deg,rgba(59,130,246,0.1),rgba(20,184,166,0.08));border:1px solid rgba(59,130,246,0.3);border-radius:8px;padding:12px 16px;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.provenance-icon{width:28px;height:28px;background:rgba(59,130,246,0.2);border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px}
.provenance-title{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--accent);margin-bottom:2px}
.provenance-text{font-size:12px;color:var(--text);font-family:'IBM Plex Mono',monospace}
.provenance-interp{font-size:10px;color:var(--text2);margin-top:1px}

/* Results grid */
.results-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:20px}
.result-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:16px;position:relative;overflow:hidden;transition:border-color 0.2s}
.result-card:hover{border-color:var(--border2)}
.result-card.highlight{border-color:rgba(59,130,246,0.4);background:rgba(59,130,246,0.05)}
.result-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.result-card.type-T::before{background:var(--red)}
.result-card.type-P::before{background:var(--amber)}
.result-card.type-v::before{background:var(--teal)}
.result-card.type-u::before{background:var(--purple)}
.result-card.type-h::before{background:var(--accent)}
.result-card.type-s::before{background:var(--green)}
.result-card.type-x::before{background:#f97316}
.result-prop{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--text3);margin-bottom:6px;display:flex;align-items:center;gap:6px}
.result-prop-sym{font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:500;color:var(--text2)}
.result-value{font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:400;color:var(--text);line-height:1;margin-bottom:4px;word-break:break-all}
.result-unit{font-size:10px;color:var(--text3);font-family:'IBM Plex Mono',monospace;letter-spacing:0.5px}
.result-note{font-size:10px;color:var(--text3);margin-top:4px;font-style:italic}

/* Warning box */
.warning-box{background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:8px;padding:14px 16px;margin-bottom:16px}
.warning-title{color:var(--red);font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px}
.warning-text{color:#fca5a5;font-size:12px;line-height:1.5}

/* Empty state */
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:300px;color:var(--text3);text-align:center;gap:12px}
.empty-state-icon{font-size:40px;opacity:0.3}
.empty-state-text{font-size:13px;line-height:1.6;max-width:280px}

/* Info rows */
.info-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);font-size:12px}
.info-row:last-child{border-bottom:none}
.info-key{color:var(--text2)}
.info-val{font-family:'IBM Plex Mono',monospace;color:var(--text)}

.section-heading{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--text3);margin-bottom:12px;margin-top:4px;display:flex;align-items:center;gap:8px}
.section-heading::after{content:'';flex:1;height:1px;background:var(--border)}

@media(max-width:768px){.app{grid-template-columns:1fr;grid-template-rows:auto auto 1fr}.sidebar{border-right:none;border-bottom:1px solid var(--border)}}
</style>
</head>
